# React Native's Metro bundler and the Expo autolinking scripts both resolve native
# modules by walking node_modules directly; pnpm's default symlinked store breaks that.
# Hoisting is the documented Expo-monorepo setting, not a workaround for a bad dep.
node-linker=hoisted

# Expo's config plugins and prebuild reach into peer packages at build time.
strict-peer-dependencies=false
auto-install-peers=true
